{
  "name": "ts-reviewer",
  "version": "2.1.0",
  "description": "Install the TypeScript Code Reviewer skill for Claude Code, Codex, or Antigravity",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/VirtualMaestro/ts-reviewer"
  },
  "bin": {
    "ts-reviewer": "dist/cli.js"
  },
  "files": [
    "dist/**",
    "ts-reviewer/**"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && node --test cnlp/skill-format.test.js tools.test.mjs",
    "dev": "npm run build && node --enable-source-maps dist/cli.js"
  },
  "keywords": [
    "typescript",
    "code-review",
    "codex",
    "antigravity",
    "claude-code",
    "skill",
    "ts-reviewer"
  ],
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.0"
  }
}
