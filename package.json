{
  "name": "ts-reviewer",
  "version": "3.6.0",
  "description": "Install the TypeScript Code Reviewer skill for Claude Code or Codex, globally or per project",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtualMaestro/pure-typescript-reviewer.git"
  },
  "bin": {
    "ts-reviewer": "dist/cli.js"
  },
  "files": [
    "dist/**",
    "assets/**"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test cnlp/skill-format.test.js tools.test.mjs test/install.test.ts",
    "dev": "node src/cli.ts"
  },
  "keywords": [
    "typescript",
    "code-review",
    "codex",
    "claude-code",
    "skill",
    "ts-reviewer"
  ],
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.0"
  }
}
